#: ui_qt/extensions_window.py:571
msgid "Auto-File Genres"
msgstr "Generi di file automatici"

#: ui_qt/extensions_window.py:575
msgid ""
"Genre folders auto-filing is allowed to use. Leave empty to let it use every"
" Title-Case folder it finds."
msgstr ""
"È consentito l'archivio automatico delle cartelle di genere. Lascia vuoto "
"per far sì che usi ogni cartella in Title-Case che trova."

#: ui_qt/extensions_window.py:591
msgid "Genre folder name"
msgstr "Nome cartella genere"

#: ui_qt/extensions_window.py:787
msgid "Remove this rejection? This will allow it to be suggested again."
msgstr ""
"Rimuovere questo rifiuto? Questo farà sì che venga suggerito di nuovo."

#: ui_qt/search_window.py:206
msgid "Comma-separate multiple terms; prefix a term with - to exclude it."
msgstr ""
"Separare più termini con la virgola; anteporre - a un termine per "
"escluderlo."

#: ui_qt/search_window.py:303
msgid "Smart Sort with Search Results"
msgstr "Ordinamento intelligente con i risultati di ricerca"

#: ui_qt/search_window.py:306
msgid ""
"After the chosen track, favour playing other tracks that match this search."
msgstr ""
"Dopo la traccia scelta, favorisci la riproduzione di altre tracce che "
"corrispondono a questa ricerca."

#: ui_qt/sort_config_window.py:81
msgid "Randomize tracks within each group"
msgstr "Randomizzare le tracce all'interno di ogni gruppo"

#: ui_qt/sort_config_window.py:83
msgid ""
"Play a group's tracks in random order instead of file order. File order "
"keeps the movements of a work together and in sequence, so this will "
"separate them."
msgstr ""
"Riproduci le tracce di un gruppo in ordine casuale anziché nell'ordine del "
"file. L'ordine del file mantiene i movimenti di un'opera insieme e in "
"sequenza, quindi questo li separerà."

#: ui_qt/track_details_window.py:261
msgid "Delete Album Folder"
msgstr "Elimina cartella album"

#: ui_qt/track_details_window.py:265
msgid ""
"Permanently deletes this folder and everything inside it, including any "
"cover art or other files. This cannot be undone."
msgstr ""
"Elimina definitivamente questa cartella e tutto il suo contenuto, comprese "
"le copertine e altri file. Non è possibile annullare l'operazione."

#: ui_qt/track_details_window.py:646
msgid ""
"Permanently delete this folder and the {0} file(s) inside it?\n"
"\n"
"{1}\n"
"\n"
"This cannot be undone."
msgstr ""
"Eliminare definitivamente questa cartella e i {0} file al suo interno?\n"
"\n"
"{1}\n"
"\n"
"Questa operazione non può essere annullata."

